# Local Reactor runtime. Used when REACTOR_API_KEY is unset.
# REACTOR_LOCAL_URL=http://localhost:8080

# Optional existing session to join in read-only monitor mode. This is useful
# when streaming-client already owns the queue and playback policy.
# REACTOR_SESSION_ID=00000000-0000-0000-0000-000000000000

# Hosted Reactor model. The API key stays on the Next.js server and is exchanged
# for a short-lived, model-scoped browser token.
# REACTOR_API_KEY=replace_with_your_reactor_api_key
# REACTOR_MODEL_NAME=fast-h3
# REACTOR_API_URL=https://api.reactor.inc
