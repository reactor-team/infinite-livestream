# ---------------------------------------------------------------- Reactor ---
# Model to drive. The client speaks the fast-h3 clip-queue contract, and
# lights up the extended surface — clip continuation, which chains a story's
# scenes into one uninterrupted video — when the deployment publishes it.
# Hosted, that deployment is `reactor/fast-h3`. A local `reactor run` of the
# in-repo model serves as `fast-h3` (independent clips only; the client
# detects the difference and falls back on its own).
REACTOR_MODEL=reactor/fast-h3
# Hosted session: set an API key. Leave empty (and pass --local, or set
# REACTOR_LOCAL=1) to drive a local `reactor run` instead.
REACTOR_API_KEY=
# REACTOR_LOCAL=1
# Where the local runtime listens (only used in local mode):
# REACTOR_LOCAL_URL=http://localhost:8080

# ------------------------------------------------------------- Upsampling ---
# Any OpenAI-compatible endpoint works: set OPENAI_BASE_URL for a proxy,
# a local vLLM, OpenRouter, etc. OPENAI_API_KEY is required.
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# The creative preset: one JSON bundle carrying the style/character every
# upsampled scene is written in and the premade idle prompts that keep the
# stream fed while chat is quiet. A bare name loads presets/<name>.json next
# to main.py; a path or *.json value loads that file. Local presets other
# than default.json stay untracked (gitignored). Format in config.py's
# load_preset docstring. Admins can swap the preset live with `!switch`
# (see ADMIN_USERS below).
PRESET=default

# Most chunks one chat prompt may expand into. The LLM decides the shape per
# idea: one scene of any legal length, or a chunked short story of up to this
# many short clips played back-to-back.
MAX_CHUNKS=6

# ------------------------------------------------------------- Moderation ---
# Viewer prompts are checked with the OpenAI moderations API before they
# reach the upsampler. This is a SEPARATE endpoint/key on purpose: inference
# gateways often do not expose /moderations, so point these at
# api.openai.com even when upsampling goes through a gateway. Unset, they
# fall back to OPENAI_API_KEY / OPENAI_BASE_URL. Errors fail closed (the
# prompt is rejected); set MODERATION_ENABLED=0 to run without moderation.
MODERATION_ENABLED=1
# MODERATION_API_KEY=sk-...
# MODERATION_BASE_URL=https://api.openai.com/v1
MODERATION_MODEL=omni-moderation-latest

# ------------------------------------------------------------ Idle filler ---
# When chat is quiet, generated prompts keep the model's queues topped up to
# this many clips (generation + playout together) so the stream never runs
# dry. Self-clamps to one below the deployment's live playout capacity, so a
# smaller deployment needs no change here. Filler clips are tagged
# `generated: true` in metadata and are popped when viewer groups need their
# slots. 0 disables. The prompts themselves come from the preset's
# idle_prompts list; an empty list also disables the filler.
IDLE_QUEUE_TARGET=6
# IDLE_PROMPTS_FILE=./idle_prompts.txt

# ---------------------------------------------------------------- Overlay ---
# Draw live status onto every outgoing frame: queue depth (top right), the
# playing scene's title/author with a dimmer "coming up" line (top left),
# "up next" between clips. Which overlay runs is code (main.py / overlay/);
# this only switches it.
OVERLAY_ENABLED=1

# ------------------------------------------------------------------- Sink ---
# Where the stream goes: rtmp | noop
SINK=noop
# Twitch:  rtmp://live.twitch.tv/app/<STREAM_KEY>
# YouTube: rtmp://a.rtmp.youtube.com/live2/<STREAM_KEY>
# Kick:    rtmps://<ingest>.global-contribute.live-video.net/app/<STREAM_KEY>
RTMP_URL=
# x264 target bitrate in kbit/s (maxrate is ~1.2x, bufsize ~2x).
RTMP_VIDEO_BITRATE_K=4500

# ------------------------------------------------------------------- Chat ---
# Enable either or both. Prompts are messages starting with CHAT_COMMAND.
CHAT_COMMAND=!prompt
# Per-author cooldown between accepted prompts, seconds.
CHAT_COOLDOWN_S=30

# Twitch chat is read anonymously over IRC; only the channel name is needed.
TWITCH_CHANNEL=

# YouTube live chat needs the video id of the running broadcast and a
# YouTube Data API v3 key.
YOUTUBE_VIDEO_ID=
YOUTUBE_API_KEY=

# ------------------------------------------------------------------ Admins ---
# Chat usernames allowed to send admin commands, comma-separated and matched
# case-insensitively. A bare name matches that username on any platform;
# scope with `twitch:name` / `youtube:name` when the same display name could
# be different people. Empty disables admin commands entirely.
#
# Admin commands (handled in admin.py, never billed against the prompt
# cooldown): `!switch <preset>` swaps the creative preset live — the name is
# looked up in presets/ at switch time, so a new JSON dropped in the folder
# is switchable without a restart.
ADMIN_USERS=
